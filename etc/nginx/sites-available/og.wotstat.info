server {
  server_name og.wotstat.info;

  include /etc/nginx/conf.d/cloudflare-realip.conf;
  include /etc/nginx/conf.d/my-proxy-realip.conf;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  location = /analytics/image.png {
    proxy_pass http://127.0.0.1:9110;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $wotstat_meta_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache wotstat_meta;
    proxy_cache_key "$scheme$wotstat_meta_host$request_uri";
    # Вариант из Vary: X-Forwarded-Host уже учтён в ключе после проверки IP.
    proxy_ignore_headers Vary;
    proxy_cache_lock on;
    proxy_cache_lock_age 20s;
    proxy_cache_lock_timeout 20s;
    proxy_read_timeout 25s;
  }

  location / { return 404; }

  listen 443 ssl;
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/og.wotstat.info/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/og.wotstat.info/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
  server_name og.wotstat.info;
  listen 80;
  listen [::]:80;
  return 301 https://og.wotstat.info$request_uri;
}
