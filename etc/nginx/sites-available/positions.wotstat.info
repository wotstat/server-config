# RU proxies keep their own HTML cache lifetimes: 5 and 15 minutes.
geo $realip_remote_addr $positions_html_cache_control {
  default "public, max-age=300";
  195.225.110.24 "";
  185.221.199.41 "";
}

server {
  server_name positions.wotstat.info;

  location /api {
    proxy_pass http://localhost:9104/api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot|otf|json)$ {
    root /app/positions/frontend/public;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    root /app/positions/frontend/public;
    try_files $uri $uri/index.html /index.html;
    add_header Cache-Control $positions_html_cache_control;
  }

  listen 443 ssl;
  listen 80;

  ssl_certificate /etc/letsencrypt/live/positions.wotstat.info/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/positions.wotstat.info/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
