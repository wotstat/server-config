server {
  server_name positions.wotstat.info;

  # Nuxt Content prerenders these public JSON files under the API prefix.
  location ^~ /api/_content/ {
    root /app/positions/frontend/public;
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /api {
    proxy_cache off;
    proxy_pass http://localhost:9104/api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
  }

  location = /_nuxt/builds/latest.json {
    root /app/positions/frontend/public;
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
  }

  location ^~ /_nuxt/ {
    root /app/positions/frontend/public;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    root /app/positions/frontend/public;
    try_files $uri $uri/index.html /index.html;
    add_header Cache-Control "public, max-age=300, must-revalidate";
  }

  listen 443 ssl;
  listen 80;

  ssl_certificate /etc/letsencrypt/live/positions.wotstat.info/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/positions.wotstat.info/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
