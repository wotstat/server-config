upstream event_saver {
  server 127.0.0.1:9100 max_fails=1 fail_timeout=10s; # blue
  server 127.0.0.1:9101 max_fails=1 fail_timeout=10s; # green
}

server {
  server_name wotstat.info;

  include /etc/nginx/conf.d/cloudflare-realip.conf;
  include /etc/nginx/conf.d/my-proxy-realip.conf;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  location /api/db/ {
    proxy_pass http://127.0.0.1:80/;
    proxy_set_header Host db.wotstat.info;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api {
    proxy_pass http://event_saver;
    proxy_next_upstream error timeout non_idempotent;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 2s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health-check {
    default_type text/plain;
    return 200 "OK";
  }

  location / {
    resolver 127.0.0.53 valid=30s ipv6=off;
    resolver_timeout 5s;
    set $website_upstream wotstat.info.website.yandexcloud.net;
    proxy_pass http://$website_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_intercept_errors on;
    error_page 404 =200 /index.html;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|map)$ {
    resolver 127.0.0.53 valid=30s ipv6=off;
    resolver_timeout 5s;
    set $website_upstream wotstat.info.website.yandexcloud.net;
    proxy_pass http://$website_upstream;
    proxy_set_header Host $host;

    proxy_intercept_errors off;
  }

  listen 443 ssl; # managed by Certbot
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/wotstat.info/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/wotstat.info/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
  server_name wotstat.info;

  if ($host = wotstat.info) {
    return 301 https://$host$request_uri;
  } # managed by Certbot

  listen 80;
  listen [::]:80;
  return 404; # managed by Certbot

}