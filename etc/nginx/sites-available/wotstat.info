upstream event_saver {
  server 127.0.0.1:9100 max_fails=1 fail_timeout=10s; # blue
  server 127.0.0.1:9101 max_fails=1 fail_timeout=10s; # green
}

server {
  server_name wotstat.info;
  root /app/wotstat/analytics-frontend/current;

  include /etc/nginx/conf.d/cloudflare-realip.conf;
  include /etc/nginx/conf.d/my-proxy-realip.conf;
  real_ip_header CF-Connecting-IP;
  real_ip_recursive on;

  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $wotstat_meta_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Кэш включён только для HTML. TTL задаёт сам Bun.
  proxy_cache off;
  proxy_cache_key "$scheme$wotstat_meta_host$request_uri";
  # Вариант из Vary: X-Forwarded-Host уже учтён в ключе после проверки IP.
  proxy_ignore_headers Vary;

  # ^~ не даёт правилу статики перехватывать API-запросы с расширением в пути.
  location ^~ /api/db/ {
    proxy_pass http://127.0.0.1:80/;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host db.wotstat.info;
    proxy_set_header X-Wotstat-Query-Endpoint $wotstat_query_endpoint;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 140s;
    proxy_send_timeout 120s;
  }

  location ^~ /api {
    proxy_pass http://event_saver;
    proxy_next_upstream error timeout non_idempotent;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 2s;
  }

  location /health-check {
    default_type text/plain;
    return 200 "OK";
  }

  # Не перенаправлять fallback в /index.html: он тоже проксируется в gateway.
  location = /_meta_fallback.html {
    internal;
    alias /app/wotstat/analytics-frontend/current/index.html;
    default_type text/html;
    open_file_cache off;
    add_header Cache-Control 'no-store' always;
  }

  location = /health {
    return 404;
  }
  location = /ready {
    return 404;
  }

  # Vite assets имеют хеш в имени. Отсутствующий файл не превращается в HTML.
  location ^~ /assets/ {
    root /app/wotstat/analytics-frontend/shared;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Файлы из public/: favicon, robots.txt, sitemap.xml и прочая статика.
  location ~* \.(?:js|mjs|css|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|map|txt|xml|json|webmanifest|pdf|wasm|mp4|webm|mp3|ogg)$ {
    try_files $uri =404;
  }

  location / {
    proxy_pass http://127.0.0.1:9110;
    proxy_cache wotstat_meta;
    proxy_cache_use_stale off;
    proxy_cache_lock off;
    proxy_connect_timeout 1s;
    proxy_read_timeout 5s;
    proxy_intercept_errors on;
    error_page 500 502 503 504 =200 /_meta_fallback.html;
  }

  listen 443 ssl; # managed by Certbot
  listen [::]:443 ssl;
  ssl_certificate /etc/letsencrypt/live/wotstat.info/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/wotstat.info/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
  server_name wotstat.info;

  if ($host = wotstat.info) {
    return 301 https://$host$request_uri;
  } # managed by Certbot

  listen 80;
  listen [::]:80;
  return 404; # managed by Certbot
}
