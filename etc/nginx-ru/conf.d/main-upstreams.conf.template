# Generated by scripts/configure-ru.py. Address changes belong in that command.
# Shared failure state across workers and all vhosts using the same transport.
upstream wotstat_main_https {
  zone wotstat_main_https 128k;
  server ${MAIN_HTTPS} max_fails=1 fail_timeout=10s;
  server ${PEER_HTTPS} backup max_fails=1 fail_timeout=10s;
  keepalive 32;
}

upstream wotstat_main_http {
  zone wotstat_main_http 128k;
  # Remember a failed direct HTTP route for five minutes across all workers.
  server ${MAIN_HTTP} max_fails=1 fail_timeout=5m;
  server ${PEER_HTTP} backup max_fails=1 fail_timeout=10s;
  keepalive 32;
}

