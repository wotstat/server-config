# Enable only on RU2, which serves the old shop hostname.
server {
  listen 80;
  listen 443 ssl;
  server_name shop.wotstat.info;

  ssl_certificate /etc/letsencrypt/live/shop.wotstat.info/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/shop.wotstat.info/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  return 301 https://shop.mtstat.info$request_uri;
}
