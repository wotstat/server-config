
map $host $subdomain {
  ~^ru\.([^.]+)\.wotstat\.info$ $1;
  default "";
}

server {
  server_name ~^ru\.([^.]+)\.wotstat\.info$;


  location / {
    proxy_pass https://wotstat_main_https$request_uri;
    include /etc/nginx/snippets/main-failover.conf;
    proxy_http_version 1.1;

    # Always set standard headers
    proxy_ssl_server_name on;
    proxy_ssl_name $subdomain.wotstat.info;
    proxy_set_header Host $subdomain.wotstat.info;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # WebSocket headers
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Only these should affect bypass/store:
    proxy_cache_bypass $is_websocket;
    proxy_no_cache $do_not_store $is_websocket;

    proxy_cache wotstat_cache_shared;
    proxy_cache_key "$scheme$request_method$host$request_uri";
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;

    add_header X-Cache-Status $x_cache_status_pretty always;
  }


  listen 80;
  listen 443 ssl;
  ssl_certificate /etc/letsencrypt/live/wotstat-subdomains/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/wotstat-subdomains/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

