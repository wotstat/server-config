# The exact mtstat service names take precedence over this first-level fallback.
server {
  server_name ~^[^.]+\.mtstat\.info$;

  listen 80;
  listen 443 ssl;
  ssl_certificate /etc/letsencrypt/live/mtstat.info/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mtstat.info/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header Cache-Control "no-store" always;

  if ($request_method !~ ^(GET|HEAD)$) {
    return 404;
  }

  return 302 https://mtstat.info/;
}
