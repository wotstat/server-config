server {
  server_name ru.positions.wotstat.info;

  location / {
    include /etc/nginx/snippets/positions-cache.conf;
    proxy_pass https://wotstat_main_https$request_uri;
    include /etc/nginx/snippets/main-failover.conf;
    proxy_ssl_server_name on;
    proxy_ssl_name positions.wotstat.info;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_method $request_method;
    proxy_set_header Host positions.wotstat.info;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect https://positions.wotstat.info/ $scheme://$host/;
    proxy_redirect http://positions.wotstat.info/ $scheme://$host/;
  }

  listen 443 ssl; # managed by Certbot
  ssl_certificate /etc/letsencrypt/live/ru.positions.wotstat.info/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/ru.positions.wotstat.info/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
  if ($host = ru.positions.wotstat.info) {
    return 301 https://$host$request_uri;
  } # managed by Certbot


  server_name ru.positions.wotstat.info;

  listen 80;
  return 404; # managed by Certbot
}
