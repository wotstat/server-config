
server {
  server_name mtstat.info;

  proxy_cache wotstat_cache_main;
  proxy_cache_key "$scheme$request_method$host$request_uri";
  proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
  proxy_cache_background_update on;
  proxy_cache_lock on;

  location = /api/db/ {
    set $wotstat_query_upstream_host wotstat.info;
    include /etc/nginx/snippets/query-cache.conf;
  }

  # Карта страниц и robots зеркала должны ссылаться на само зеркало.
  location ~ ^/(?:sitemap(?:-google)?\.xml|robots\.txt)$ {
    include /etc/nginx/snippets/mtstat-main-proxy.conf;
    proxy_set_header Accept-Encoding "";
    # Старый кеш мог содержать сжатый ответ, к которому sub_filter неприменим.
    proxy_cache_key "$scheme$request_method$host$request_uri:identity";
    sub_filter_types text/xml application/xml text/plain;
    sub_filter_once off;
    sub_filter 'https://wotstat.info/' 'https://mtstat.info/';
  }

  location / {
    include /etc/nginx/snippets/mtstat-main-proxy.conf;
  }

  listen 443 ssl; # managed by Certbot
  ssl_certificate /etc/letsencrypt/live/mtstat.info/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/mtstat.info/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
  if ($host = mtstat.info) {
    return 301 https://$host$request_uri;
  } # managed by Certbot


  server_name mtstat.info;
  listen 80;
  return 404; # managed by Certbot
}
