
server {
  server_name ru.wotstat.info;

  proxy_cache wotstat_cache_main;
  proxy_cache_key "$scheme$request_method$host$request_uri";
  # proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
  proxy_cache_background_update on;
  proxy_cache_lock on;

  location = /api/db/ {
    set $wotstat_query_upstream_host wotstat.info;
    include /etc/nginx/snippets/query-cache.conf;
  }

  location / {
    # resolver 8.8.8.8 1.1.1.1 valid=300s;
    # proxy_pass http://wotstat.info$request_uri;
    proxy_pass https://$main_server_ip$request_uri;
    proxy_method $request_method;
    proxy_set_header Host wotstat.info;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    add_header X-Cache-Status $upstream_cache_status always;
    add_header X-Cache-Age $upstream_http_age always;
  }

  listen 443 ssl; # managed by Certbot
  ssl_certificate /etc/letsencrypt/live/ru.wotstat.info/fullchain.pem; # managed by Certbot
  ssl_certificate_key /etc/letsencrypt/live/ru.wotstat.info/privkey.pem; # managed by Certbot
  include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
  if ($host = ru.wotstat.info) {
    return 301 https://$host$request_uri;
  } # managed by Certbot


  server_name ru.wotstat.info;

  listen 80;
  return 404; # managed by Certbot
}
