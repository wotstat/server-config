# Generated by scripts/configure-ru.py. Include inside stream {}, not http {}.
# These listeners NEVER use wotstat_main_http(s) or the peer: at most one RU hop.
# HTTPS remains encrypted all the way from the entry RU nginx to main.
server {
  listen 18443;
  listen [::]:18443;
  allow ${PEER_IP};
  deny all;
  proxy_pass ${MAIN_HTTPS};
  proxy_connect_timeout 3s;
  proxy_timeout 130s;
  proxy_next_upstream off;
}

# Preserve the existing HTTP transport for the legacy positions aliases.
server {
  listen 18080;
  listen [::]:18080;
  allow ${PEER_IP};
  deny all;
  proxy_pass ${MAIN_HTTP};
  proxy_connect_timeout 3s;
  proxy_timeout 130s;
  proxy_next_upstream off;
}
